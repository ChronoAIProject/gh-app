# Template for `make test-e2e`. Copy it and fill in your own values:
#
#     cp .env.example .env
#
# .env is git-ignored; this template is not, so keep real values out of it.
# The App ID and repository coordinates are not secrets. The private key is
# the secret, and only its path is recorded, never the key itself.
#
# Store the key outside the repository. .gitignore covers *.pem, but ignored
# files are exactly what `git clean -xdf` deletes, so a key kept in the working
# tree can disappear without warning.
#
# With .env in place, `make test-e2e` runs the live tests against the real
# GitHub API. Leave the values blank and they skip; fill in only some and they
# fail rather than pass silently. `make test` stays offline either way.

# GitHub → Settings → Developer settings → GitHub Apps → your app → "App ID"
# (a 6-7 digit number near the top of the General tab)
GH_APP_E2E_APP_ID=123456

# Absolute path, or ~/ — both are accepted.
GH_APP_E2E_KEY=~/.config/gh-app/keys/private-key.pem

# A repository the App installation can access.
GH_APP_E2E_OWNER=MyOrganization
GH_APP_E2E_REPO=my-repository

# GitHub Enterprise Server only:
#GH_APP_E2E_HOST=github.example.com
#GH_APP_E2E_API_URL=https://github.example.com/api/v3
